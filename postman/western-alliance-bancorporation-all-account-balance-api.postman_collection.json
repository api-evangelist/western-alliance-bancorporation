			"type": "default"
		},
		{
			"key": "ClientSecret",
			"value": "",
			"type": "default"
		},
		{
			"key": "ClientId",
			"value": "",
			"type": "default"
		},
		{
			"key": "BASE_PATH_BALANCE_SERVICE",
