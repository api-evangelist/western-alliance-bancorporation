{
	"info": {
		"_postman_id": "6f5715cb-0ed8-4da1-aad3-6ef30ceb102f",
		"name": "Book Transfer API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get Token",
			"item": [
				{
					"name": "Get token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let jsonData = pm.response.json();\r",
									"pm.collectionVariables.set(\"BearerToken\", jsonData.access_token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [
							{
								"key": "appClientId",
								"value": "{{ClientId}}",
								"type": "text"
							},
							{
								"key": "appClientSecret",
								"value": "{{ClientSecret}}",
								"type": "text"
							},
							{
								"key": "X-Correlation-ID",
								"value": "{{$guid}}",
								"type": "text"
							},
							{
								"key": "X-Source-System",
								"value": "",
								"type": "text",
								"disabled": true
							}
						],
						"url": {
							"raw": "https://{{PUBLIC_HOST}}{{BASE_PATH_TOKEN_SERVICE}}/token?Scope=Informational",
							"protocol": "https",
							"host": [
								"{{PUBLIC_HOST}}{{BASE_PATH_TOKEN_SERVICE}}"
							],
							"path": [
								"token"
							],
							"query": [
								{
									"key": "Scope",
									"value": "Informational"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Health Check",
			"item": [
				{
					"name": "Healthcheck",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{BearerToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "X-Correlation-ID",
								"value": "{{$guid}}",
								"type": "text"
							},
							{
								"key": "X-Dependent-Ping",
								"value": "false",
								"type": "text"
							},
							{
								"key": "X-Source-System",
								"value": "",
								"type": "default",
								"disabled": true
							}
						],
						"url": {
							"raw": "https://{{PUBLIC_HOST}}{{BASE_PATH_PRIORDAY_SERVICE}}/healthcheck",
							"protocol": "https",
							"host": [
								"{{PUBLIC_HOST}}{{BASE_PATH_PRIORDAY_SERVICE}}"
							],
							"path": [
								"healthcheck"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Book Transfer",
			"item": [
				{
					"name": "Book Transfer",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{BearerToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "X-Correlation-ID",
								"type": "text",
								"value": "{{$guid}}"
							},
							{
								"key": "X-Source-System",
								"value": "",
								"type": "default",
								"disabled": true
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"StandardDollarTransferData\": {\r\n        \"FromAccountNumber\" : {{From_AccountNumber}}, \r\n        \"TransactionAmount\" : 1,  \r\n        \"FromTrailerDescription\" : \"test source trailer description\" ,\r\n        \"ToAccountNumber\" : {{To_AccountNumber}}, \r\n        \"ToTrailerDescription\" : \"test destination trailer description\"\r\n    }\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "https://{{PUBLIC_HOST}}{{BASE_PATH_TRANSFER_SERVICE}}/dp/transactions/transfer",
							"protocol": "https",
							"host": [
								"{{PUBLIC_HOST}}{{BASE_PATH_TRANSFER_SERVICE}}"
							],
							"path": [
								"dp",
								"transactions",
								"transfer"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "BearerToken",
			"value": "",
			"type": "default"
		},
		{
			"key": "PUBLIC_HOST",
			"value": "api-connect.westernalliancebank.com",
			"type": "default"
		},
		{
			"key": "ClientId",
			"value": "",
			"type": "default"
		},
		{
			"key": "ClientSecret",
			"value": "",
			"type": "default"
		},
		{
			"key": "From_AccountNumber",
			"value": "",
			"type": "default"
		},
		{
			"key": "To_AccountNumber",
			"value": "",
			"type": "default"
		},
		{
			"key": "BASE_PATH_TOKEN_SERVICE",
			"value": "/entitlements-get-token-eapi/api/v1",
			"type": "default"
		},
		{
			"key": "BASE_PATH_TRANSFER_SERVICE",
			"value": "/info-book-transfer-eapi/api/v1",
			"type": "default"
		}
	]
}