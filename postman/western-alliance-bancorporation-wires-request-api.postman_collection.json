								"value": "{{$guid}}",
								"type": "text"
							},
							{
								"key": "X-Source-System",
								"value": "",
								"type": "text",
								"disabled": true
							},
							{
								"key": "X-Dependent-Ping",
								"value": "false",
								"type": "text"
							}
						],
						"url": {
							"raw": "https://{{PUBLIC_HOST}}{{BASE_PATH_WIRES}}/healthcheck",
							"protocol": "https",
							"host": [
								"{{PUBLIC_HOST}}{{BASE_PATH_WIRES}}"
							],
							"path": [
								"healthcheck"
							]
						}
					},
					"response": []
				}
			]
		},
