{
	"info": {
		"_postman_id": "9e55f052-5561-4d6d-ad1f-825326640cd4",
		"name": "All Account Intraday API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get Token",
			"item": [
				{
					"name": "Get token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let jsonData = pm.response.json();\r",
									"pm.collectionVariables.set(\"BearerToken\", jsonData.access_token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [
							{
								"key": "appClientId",
								"value": "{{ClientId}}",
								"type": "text"
							},
							{
								"key": "appClientSecret",
								"value": "{{ClientSecret}}",
								"type": "text"
							},
							{
								"key": "X-Correlation-ID",
								"value": "{{$guid}}",
								"type": "text"
							},
							{
								"key": "X-Source-System",
								"value": "",
								"type": "text",
								"disabled": true
							}
						],
						"url": {
							"raw": "https://{{PUBLIC_HOST}}{{BASE_PATH_TOKEN_SERVICE}}/token?Scope=Informational",
							"protocol": "https",
							"host": [
								"{{PUBLIC_HOST}}{{BASE_PATH_TOKEN_SERVICE}}"
							],
							"path": [
								"token"
							],
							"query": [
								{
									"key": "Scope",
									"value": "Informational"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Health Check",
			"item": [
				{
					"name": "Healthcheck",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{BearerToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "X-Correlation-Id",
								"value": "{{$guid}}",
								"type": "text"
							},
							{
								"key": "X-Dependent-Ping",
								"value": "false",
								"type": "text"
							},
							{
								"key": "X-Source-System",
								"value": "",
								"type": "default",
								"disabled": true
							}
						],
						"url": {
							"raw": "https://{{PUBLIC_HOST}}{{BASE_PATH_INTRADAY_SERVICE}}/healthcheck",
							"protocol": "https",
							"host": [
								"{{PUBLIC_HOST}}{{BASE_PATH_INTRADAY_SERVICE}}"
							],
							"path": [
								"healthcheck"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Transaction History Intraday",
			"item": [
				{
					"name": "Get Intraday transactions",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{BearerToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "X-Correlation-Id",
								"value": "{{$guid}}",
								"type": "text"
							},
							{
								"key": "X-Source-System",
								"value": "",
								"type": "default",
								"disabled": true
							},
							{
								"key": "X-Next-Page-Key",
								"value": "",
								"type": "default",
								"disabled": true
							}
						],
						"url": {
							"raw": "https://{{PUBLIC_HOST}}{{BASE_PATH_INTRADAY_SERVICE}}/dp/accounts/transactions/intraday",
							"protocol": "https",
							"host": [
								"{{PUBLIC_HOST}}{{BASE_PATH_INTRADAY_SERVICE}}"
							],
							"path": [
								"dp",
								"accounts",
								"transactions",
								"intraday"
							],
							"query": [
								{
									"key": "FilterType",
									"value": "",
									"description": "filter on basis of type of payment",
									"disabled": true
								},
								{
									"key": "CheckNumber",
									"value": "",
									"description": "The check number to search for.",
									"disabled": true
								},
								{
									"key": "Amount",
									"value": "",
									"description": "The amount to search for.",
									"disabled": true
								},
								{
									"key": "TransactionCode",
									"value": "",
									"description": "The transaction code to search for.",
									"disabled": true
								},
								{
									"key": "TimeDepositId",
									"value": null,
									"disabled": true
								}
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "BearerToken",
			"value": "",
			"type": "default"
		},
		{
			"key": "PUBLIC_HOST",
			"value": "api-connect.westernalliancebank.com",
			"type": "default"
		},
		{
			"key": "ClientId",
			"value": "",
			"type": "default"
		},
		{
			"key": "ClientSecret",
			"value": "",
			"type": "default"
		},
		{
			"key": "BASE_PATH_INTRADAY_SERVICE",
			"value": "/info-multi-acc-intraday-eapi/api/v1",
			"type": "default"
		},
		{
			"key": "BASE_PATH_TOKEN_SERVICE",
			"value": "/entitlements-get-token-eapi/api/v1",
			"type": "default"
