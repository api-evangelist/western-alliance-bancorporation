{
	"info": {
		"_postman_id": "a0d193fd-d8c1-4934-a282-379e24834a2b",
		"name": "All Account Priorday API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get Token",
			"item": [
				{
					"name": "Get token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let jsonData = pm.response.json();\r",
									"pm.collectionVariables.set(\"BearerToken\", jsonData.access_token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [
							{
								"key": "appClientId",
								"value": "{{ClientId}}",
								"type": "text"
							},
							{
								"key": "appClientSecret",
								"value": "{{ClientSecret}}",
								"type": "text"
							},
							{
								"key": "X-Correlation-ID",
								"value": "{{$guid}}",
								"type": "text"
							},
							{
								"key": "X-Source-System",
								"value": "",
								"type": "text",
								"disabled": true
							}
						],
						"url": {
							"raw": "https://{{PUBLIC_HOST}}{{BASE_PATH_TOKEN_SERVICE}}/token?Scope=Informational",
							"protocol": "https",
							"host": [
								"{{PUBLIC_HOST}}{{BASE_PATH_TOKEN_SERVICE}}"
							],
							"path": [
								"token"
							],
							"query": [
								{
									"key": "Scope",
									"value": "Informational"
								},
								{
									"key": "Resource",
									"value": "https://microsoft.graph.com",
									"disabled": true
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Health check",
			"item": [
				{
					"name": "Healthcheck",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{BearerToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "X-Correlation-Id",
								"value": "{{$guid}}",
								"type": "text"
							},
							{
								"key": "X-Dependent-Ping",
								"value": "false",
								"type": "text"
							},
							{
								"key": "X-Source-System",
								"value": "",
								"type": "default",
								"disabled": true
							}
						],
						"url": {
							"raw": "https://{{PUBLIC_HOST}}{{BASE_PATH_PRIORDAY_SERVICE}}/healthcheck",
							"protocol": "https",
							"host": [
								"{{PUBLIC_HOST}}{{BASE_PATH_PRIORDAY_SERVICE}}"
							],
							"path": [
								"healthcheck"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Transaction History Priorday",
			"item": [
				{
					"name": "Get Priorday transactions",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{BearerToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "X-Correlation-Id",
								"value": "{{$guid}}",
								"type": "text"
							},
							{
								"key": "X-Source-System",
								"value": "",
								"type": "default",
								"disabled": true
							},
							{
								"key": "X-Next-Page-Key",
								"value": "",
								"type": "default",
								"disabled": true
							}
						],
						"url": {
							"raw": "https://{{PUBLIC_HOST}}{{BASE_PATH_PRIORDAY_SERVICE}}/dp/accounts/transactions/priorDay",
							"protocol": "https",
							"host": [
								"{{PUBLIC_HOST}}{{BASE_PATH_PRIORDAY_SERVICE}}"
							],
							"path": [
								"dp",
								"accounts",
								"transactions",
								"priorDay"
							],
							"query": [
								{
									"key": "CheckOrSerialNumber",
									"value": null,
									"description": "Can be used to limit the transactions returned to those with this serial/check number",
									"disabled": true
								},
								{
									"key": "TransactionAmount",
									"value": null,
									"description": "Can be used to limit the transactions returned to those with this amount",
									"disabled": true
								},
								{
									"key": "TransactionCode",
									"value": null,
									"description": "Can be used to limit the transactions returned to those with this transaction code",
									"disabled": true
								},
								{
									"key": "TransactionFilterType",
									"value": null,
									"description": "Code used to indicate which type of transaction filtering should be performed",
									"disabled": true
								},
								{
									"key": "ReturnExtended",
									"value": null,
									"description": "The type of inquiry desired",
									"disabled": true
								},
								{
									"key": "TransactionCodeList",
									"value": null,
									"description": "Can be used to limit the transactions returned to those with these transaction codes. Maximum number of transaction codes to filter on is 10",
									"disabled": true
								},
								{
									"key": "TransactionDate",
									"value": null,
									"description": "The closing date in 'yyyy-MM-dd' format to use as the prior day. Defaults to the last business day from the current date",
									"disabled": true
								}
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
